# ============================================================
# Unified Service Desk — Variables de Entorno Requeridas
# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees .env al repositorio.
# ============================================================

# Base de datos (SQLite local para desarrollo, PostgreSQL para producción)
DATABASE_URL=sqlite:///./unified_service_desk.db
# DATABASE_URL=postgresql://user:password@localhost:5432/servicedesk

# Seguridad JWT — OBLIGATORIO en staging/producción.
# Genera un valor seguro con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIA_ESTE_VALOR_POR_UNO_ALEATORIO_SEGURO
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Contraseña de semilla para usuarios de prueba (solo desarrollo/testing).
# Se hashea con Argon2id antes de persistir. NUNCA usar en producción.
SEED_DEFAULT_PASSWORD=UniServiceDesk2026!

# Configuración de CORS (separada por comas)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Entorno de ejecución
DEBUG=false
